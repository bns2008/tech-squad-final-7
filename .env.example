# ── Copy this file to .env and fill in the values ──────────────────────────
# cp .env.example .env

# Mistral AI API Key (get from https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Neon PostgreSQL Database URL (shared team database)
# Ask the project admin for the actual credentials
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-still-lab-aw203auj-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# SMTP Configuration for sending OTP emails
# For Gmail: Use your Gmail address and App Password (not regular password)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password